generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  COMPANY
}

model Accounts {
  id         String  @id
  email      String  @unique
  password   String
  role       Role
  isVerified Boolean @default(false)

  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    Users?
  companys Companys?
}

model Users {
  id String @id @default(cuid())

  userId   String   @unique
  accounts Accounts @relation(fields: [userId], references: [id])

  firstName   String?
  lastName    String?
  phone       String?
  address     String?
  experience  Int?
  workArea    String?
  description String?

  userPreference UserPreference?
  applications   Application[]
}

model Companys {
  id String @id @default(cuid())

  userId   String   @unique
  accounts Accounts @relation(fields: [userId], references: [id])

  companyName String?
  rif         String?
  phone       String?
  address     String?
  description String?

  // Datos opcionales
  website String?
  size    String? // Por ejemplo: "1-10", "11-50", etc.
  sector  String? // Por ejemplo: "technology", "health", etc.
  logoUrl String? // (lo tenías originalmente, lo conservamos)

  vacantes Vacancys[]
}

model Vacancys {
  id               String    @id @default(cuid())
  empresaId        String
  nombrePuesto     String
  descripcion      String?
  ubicacion        String?
  salarioMin       String?
  salarioMax       String?
  modalidad        String?
  tipoContrato     String?
  fechaPublicacion DateTime  @default(now())
  fechaFinita      DateTime?
  estado           String?

  company      Companys      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  applications Application[]
}

model Application {
  id               String   @id @default(cuid())
  userId           String
  vacanteId        String
  fechaPostulacion DateTime @default(now()) @map("fecha_postulacion")
  estado           String?

  user    Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vacancy Vacancys @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id                String  @id @default(cuid())
  userId            String  @unique
  modalidadPref     String?
  rangoSalarioMin   Int?
  rangoSalarioMax   Int?
  ubicacionDeseada  String?
  categoriasInteres String?

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)
}
